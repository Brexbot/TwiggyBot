{
  "name": "brexbot",
  "version": "0.0.1",
  "description": "Bot for the Bananasaurus_Rex Discord server",
  "main": "./build/main.js",
  "scripts": {
    "build": "rimraf ./build && prisma generate && tsc",
    "dev": "node --loader ts-node/esm/transpile-only src/main.ts",
    "start": "nodemon --exec node --loader ts-node/esm/transpile-only src/main.ts",
    "serve": "node build/main.js",
    "lint": "eslint -c eslint.config.js",
    "lint:fix": "eslint -c eslint.config.js --fix",
    "eloDecay": " node ./build/standalones/eloDecay.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brexbot/DiscordBot.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Brexbot/DiscordBot/issues"
  },
  "homepage": "https://github.com/Brexbot/DiscordBot#readme",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@discordx/di": "^3.3.4",
    "@discordx/importer": "^1.3.3",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "cron": "^4.4.0",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "hsl-rgb": "^1.0.0",
    "localisetimemodule": "github:QOAL/localiseTimeModule#20230503",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "sponge-case": "^2.0.3",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0"
  },
  "overrides": {
    "mathjs": "^15.2.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "better-sqlite3": true,
    "prisma": true
  }
}
